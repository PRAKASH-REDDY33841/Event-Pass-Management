{
  "name": "event-pass-system",
  "version": "1.0.0",
  "description": "Event Ticketing & QR Code Check-In System with Cryptographic Verification and Real-Time Dashboard",
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix client install --include=dev",
    "server": "node --watch --watch-path=server/src server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"cyan,magenta\" --names \"SERVER,CLIENT\" \"node --watch --watch-path=server/src server/src/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "event-ticketing",
    "qr-code",
    "check-in",
    "security",
    "jwt",
    "socket-io"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}