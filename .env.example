# ============================================================
# EventPass Security Engine - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# The server will work with defaults (no .env needed for dev).

# ── Server ──────────────────────────────────────────────────
PORT=5000

# ── Database ────────────────────────────────────────────────
# Absolute or relative path to the SQLite database file.
# Default: server/data/eventpass.db
# DB_PATH=./server/data/eventpass.db

# ── Security / JWT ──────────────────────────────────────────
# Secret key used to sign all ticket JWTs and organizer session tokens.
# REQUIRED in production — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=change_me_to_a_long_random_secret_in_production

# ── Organizer Master Passkey ────────────────────────────────
# Optional fallback passkey for admin/developer access (bypass login).
# Default: eventpass2026
# ORGANIZER_KEY=eventpass2026

# ── Email (SMTP) ─────────────────────────────────────────────
# If not set, Ethereal (test mailer) is used automatically.
# Preview links will be printed to the server console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="EventPass Ticketing" <noreply@yourdomain.com>

# ── Demo Organizer Credentials (pre-seeded) ─────────────────
# Email:    organizer@eventpass.io
# Password: Organizer2026!

